# StriveAI v2 — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit .env.
# See docs/SECURITY_NOTES.md for setup and rotation guidance.

# ─── Server ───────────────────────────────────────────────
PORT=3000

# ─── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── Firebase Web Config (served to browser via /api/config) ──
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Firebase Admin (backend Firestore writes for Telegram/cron) ──
# Paste the full JSON content of your service account key as a single line.
# Generate at: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"..."}

# ─── Telegram Bot ─────────────────────────────────────────
# Create bot: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=1234567890:your-telegram-bot-token-here
TELEGRAM_BOT_USERNAME=YourBotUsername
# Random secret to verify Telegram webhook requests (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-here

# ─── Cron Protection ──────────────────────────────────────
# Protects /api/cron/* routes from public calls (openssl rand -hex 32)
CRON_SECRET=your-random-cron-secret-here

# ─── App URL ──────────────────────────────────────────────
APP_BASE_URL=https://your-app.vercel.app

# ─── Removed / Legacy (kept so existing server.js does not crash) ──
# PayPal billing is removed from v2 MVP. These are still read by the current
# server.js but the billing routes will be deleted in the v2 rewrite.
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE
PAYPAL_PLAN_PRO=YOUR_PAYPAL_PLAN_ID_PRO_HERE
PAYPAL_PLAN_TEAM=YOUR_PAYPAL_PLAN_ID_TEAM_HERE
PAYPAL_SDK_URL=https://www.paypal.com/sdk/js

# ─── Removed / Legacy — Email SMTP ───────────────────────
# Email notifications are replaced by Telegram in v2.
# The existing /api/notify/reminder route will be replaced by
# /api/notify/telegram in the v2 rewrite.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=your-smtp-password-here
SMTP_FROM=noreply@example.com
