rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.email in ['ramaman747@gmail.com']);
      allow write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.email in ['ramaman747@gmail.com']);
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
